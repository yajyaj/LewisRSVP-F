{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/backend/api/:path*",
      "destination": "https://lewis-rsvp-b.vercel.app/api/:path*"
    },
    {
      "source": "/backend/sanctum/csrf-cookie",
      "destination": "https://lewis-rsvp-b.vercel.app/sanctum/csrf-cookie"
    },
    {
      "source": "/((?!backend/).*)",
      "destination": "/index.html"
    }
  ]
}
